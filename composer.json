{
    "name": "yasinkuyu/omnipay-paratika",
    "type": "library",
    "description": "Paratika (Payten / Asseco) gateway for Omnipay: hosted payment page (HPP), sdSha512 + QUERYTRANSACTION verification, refund, void, status. Also VakıfPayS and ZiraatPay.",
    "keywords": ["paratika", "payten", "asseco", "vakifpay", "vakifpays", "ziraatpay", "sanal pos", "3d secure", "hpp", "omnipay", "gateway", "payment"],
    "homepage": "https://github.com/yasinkuyu/omnipay-paratika",
    "license": "MIT",
    "authors": [
        {"name": "Yasin Kuyu", "email": "yasinkuyu@gmail.com"},
        {"name": "Contributors", "homepage": "https://github.com/yasinkuyu/omnipay-paratika/contributors"}
    ],
    "autoload": {"psr-4": {"Omnipay\\Paratika\\": "src/"}},
    "autoload-dev": {"psr-4": {"Omnipay\\Paratika\\Tests\\": "tests/"}},
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "omnipay/common": "^3.3"
    },
    "require-dev": {
        "omnipay/tests": "^4.1",
        "php-http/guzzle7-adapter": "^1.0",
        "phpunit/phpunit": "^9.6"
    },
    "extra": {"branch-alias": {"dev-3.x": "3.x-dev"}},
    "config": {"allow-plugins": {"php-http/discovery": true}},
    "minimum-stability": "dev",
    "prefer-stable": true
}
